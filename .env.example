# Copy this file to ".env" (same folder) and fill it in. ".env" is gitignored; never commit it.
# Only needed when `notifier: discord` is set in config.yaml.

# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Anyone with this URL can post to your channel, so treat it like a password.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
